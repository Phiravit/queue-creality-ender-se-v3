# Copy this file to config.env and fill it in. Never commit config.env.

# Staff password for /admin (pick a new one, not the OctoPrint or Pi password)
ADMIN_PASSWORD=

# Where the queue web page listens. Students open http://<pi-ip>:8000
HOST=0.0.0.0
PORT=8000

# One block per printer. URL is OctoPrint as seen FROM THE PI (127.0.0.1 when
# the queue runs on the same Pi). API key: OctoPrint > Settings > Application Keys
# (or Settings > API > Global API key), made while logged in as that instance's admin.
PRINTER1_NAME=Free Use Printer (Printer 1)
PRINTER1_URL=http://127.0.0.1:5001
PRINTER1_APIKEY=
# Optional webcam snapshot shown next to the "Plate is clear" button, e.g.
# http://127.0.0.1:8080/?action=snapshot  (leave empty if there is no camera)
PRINTER1_SNAPSHOT=

PRINTER2_NAME=Research Printer (Printer 2)
PRINTER2_URL=http://127.0.0.1:5002
PRINTER2_APIKEY=
PRINTER2_SNAPSHOT=

# Students sign in with a university email on one of these domains (comma-separated).
# For SIT students only, keep just ad.sit.kmutt.ac.th (and mail.kmutt.ac.th if SIT uses it).
ALLOWED_EMAIL_DOMAINS=mail.kmutt.ac.th,ad.sit.kmutt.ac.th,kmutt.ac.th

# Discord alerts (optional). In Discord: channel settings > Integrations >
# Webhooks > New Webhook > Copy Webhook URL. Leave empty to turn alerts off.
DISCORD_WEBHOOK_URL=
# Optional: role to ping on errors (Server settings > Roles > right-click > Copy Role ID;
# needs Developer Mode on). Leave empty for no pings.
DISCORD_STAFF_ROLE_ID=
# The queue's address, added under each alert so students can tap through.
PUBLIC_URL=http://<pi-ip>:8000

# Tuning (defaults are fine)
POLL_SECONDS=5
MAX_UPLOAD_MB=100
START_GRACE_SECONDS=30
BAD_POLLS_BEFORE_LOCK=3
