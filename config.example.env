# Copy this file to config.env and fill it in. Never commit config.env.

# Staff password for /admin (pick a new one, not the OctoPrint or Pi password)
ADMIN_PASSWORD=

# Where the queue web page listens. Students open http://<pi-ip>:8000
HOST=0.0.0.0
PORT=8000

# One block per printer. URL is OctoPrint as seen FROM THE PI (127.0.0.1 when
# the queue runs on the same Pi). API key: OctoPrint > Settings > Application Keys
# (or Settings > API > Global API key), made while logged in as that instance's admin.
PRINTER1_NAME=Free Use Printer (Printer 1)
PRINTER1_URL=http://127.0.0.1:5001
PRINTER1_APIKEY=
# Optional webcam snapshot shown next to the "Plate is clear" button, e.g.
# http://127.0.0.1:8080/?action=snapshot  (leave empty if there is no camera)
PRINTER1_SNAPSHOT=

PRINTER2_NAME=Research Printer (Printer 2)
PRINTER2_URL=http://127.0.0.1:5002
PRINTER2_APIKEY=
PRINTER2_SNAPSHOT=
# Optional: students need this password to queue on this printer (asked once per
# device; staff never need it). Leave empty for no password. Works for any printer.
PRINTER2_PASSWORD=

# Students sign in with their student ID. Which IDs are accepted (a regular expression).
# The default is 6-15 digits; tighten it to SIT's ID format if you like.
STUDENT_ID_PATTERN=^[0-9]{6,15}$

# Discord alerts (optional), up to 9 servers. In each server: channel settings >
# Integrations > Webhooks > New Webhook > Copy Webhook URL. Paste the link as it is
# (no quotes or brackets). Leave empty to turn that server off.
# STAFF_ROLE_ID: optional role to ping on errors in THAT server (Server settings > Roles >
# right-click > Copy Role ID; needs Developer Mode on). Leave empty for no pings.
# PRINTERS: which printers this webhook follows, e.g. 2 or 1,2. Empty = all printers.
DISCORD1_WEBHOOK_URL=
DISCORD1_STAFF_ROLE_ID=
DISCORD1_PRINTERS=
DISCORD2_WEBHOOK_URL=
DISCORD2_STAFF_ROLE_ID=
DISCORD2_PRINTERS=
DISCORD3_WEBHOOK_URL=
DISCORD3_STAFF_ROLE_ID=
DISCORD3_PRINTERS=
# A live status message (every printer's state and queue) that the queue keeps editing.
# Set to 0 for alerts only.
DISCORD_STATUS_BOARD=1
# The queue's address, added under each alert so students can tap through.
PUBLIC_URL=http://<pi-ip>:8000

# Tuning (defaults are fine)
POLL_SECONDS=5
MAX_UPLOAD_MB=100
START_GRACE_SECONDS=30
BAD_POLLS_BEFORE_LOCK=3
# How far ahead students can time a print (days)
MAX_BOOK_DAYS=7
